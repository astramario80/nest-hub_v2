{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/lib/bell-schedule-import.json",
      "destination": "/api/bell-workspace"
    },
    {
      "source": "/lib/bell-schedule-seed.mjs",
      "destination": "/api/bell-workspace"
    },
    {
      "source": "/service/management",
      "destination": "/service-management"
    },
    {
      "source": "/dj/:period",
      "destination": "/api/dj?period=:period"
    },
    {
      "source": "/lib/field-trips/:path*",
      "destination": "/api/field-trips?blocked=1"
    },
    {
      "source": "/lab-teacher",
      "destination": "/api/lab-teacher"
    },
    {
      "source": "/nestrequest",
      "destination": "/lab-request"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/nest_menu_icon.png"
    },
    {
      "source": "/divisions/:period",
      "destination": "/api/division-page?period=:period"
    }
  ],
  "functions": {
    "api/purchasing.mjs": {
      "maxDuration": 60
    },
    "api/account.mjs": {
      "maxDuration": 60,
      "regions": [
        "sfo1"
      ]
    },
    "api/auth.mjs": {
      "maxDuration": 60,
      "regions": [
        "sfo1"
      ]
    },
    "api/spinner.mjs": {
      "maxDuration": 60
    },
    "api/leadership.mjs": {
      "maxDuration": 50
    },
    "api/lab-storage.mjs": {
      "maxDuration": 60
    },
    "api/lab-requests.mjs": {
      "maxDuration": 60
    },
    "api/weather-native.mjs": {
      "maxDuration": 60
    },
    "api/weather.mjs": {
      "maxDuration": 30
    },
    "api/hiring-access.mjs": {
      "maxDuration": 30
    },
    "api/hiring.mjs": {
      "maxDuration": 60
    },
    "api/signals.mjs": {
      "maxDuration": 60,
      "includeFiles": "lib/signals-player/**"
    },
    "api/fabrication.mjs": {
      "maxDuration": 60
    },
    "api/division.mjs": {
      "maxDuration": 60
    },
    "api/division-page.mjs": {
      "maxDuration": 60
    },
    "api/service-workspace.mjs": {
      "maxDuration": 60
    },
    "api/service-requests.mjs": {
      "maxDuration": 60
    },
    "api/doughnut-barometer.mjs": {
      "maxDuration": 60
    },
    "api/group-email.mjs": {
      "maxDuration": 120
    },
    "api/group-email-send.mjs": {
      "maxDuration": 180,
      "regions": [
        "sfo1"
      ]
    },
    "api/group-email-history.mjs": {
      "maxDuration": 90,
      "regions": [
        "sfo1"
      ]
    },
    "api/diagnostics.mjs": {
      "maxDuration": 30
    },
    "api/robotics.mjs": {
      "maxDuration": 60
    },
    "api/finished-list.mjs": {
      "maxDuration": 60
    },
    "api/group-email-archive.mjs": {
      "maxDuration": 180,
      "regions": [
        "sfo1"
      ]
    },
    "api/inventory.mjs": {
      "maxDuration": 60
    },
    "api/lab-teacher.mjs": {
      "maxDuration": 60
    },
    "api/service-upload.mjs": {
      "maxDuration": 60
    },
    "api/service-attachments.mjs": {
      "maxDuration": 300
    },
    "api/field-trips.mjs": {
      "maxDuration": 60,
      "includeFiles": "{lib/field-trips/**,js/field-trips/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    },
    "api/dj.mjs": {
      "maxDuration": 60
    },
    "api/robotics-signup.mjs": {
      "maxDuration": 60
    },
    "api/employment-application.mjs": {
      "maxDuration": 60
    },
    "api/marketing-film.mjs": {
      "maxDuration": 60
    },
    "api/safety.mjs": {
      "maxDuration": 60
    },
    "api/metar.mjs": {
      "maxDuration": 20
    },
    "api/field-trip-roster-sync.mjs": {
      "maxDuration": 180,
      "includeFiles": "{lib/field-trips/**,js/field-trips/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    },
    "api/bell-workspace.mjs": {
      "maxDuration": 60,
      "regions": [
        "sfo1"
      ]
    }
  },
  "redirects": [
    {
      "source": "/leadership-application.html",
      "destination": "/employment",
      "permanent": false
    },
    {
      "source": "/leadership-application",
      "destination": "/employment",
      "permanent": false
    },
    {
      "source": "/field-trips",
      "destination": "/triphub",
      "permanent": true
    },
    {
      "source": "/field-trips.html",
      "destination": "/triphub",
      "permanent": true
    },
    {
      "source": "/admin-diagnostics",
      "destination": "/profile#diagnostics",
      "permanent": false
    },
    {
      "source": "/admin-diagnostics.html",
      "destination": "/profile#diagnostics",
      "permanent": false
    },
    {
      "source": "/lib/signals-player/:path*",
      "destination": "/api/signals?asset=blocked",
      "permanent": false
    },
    {
      "source": "/lib/division-slides.mjs",
      "destination": "/api/division?period=blocked",
      "permanent": false
    },
    {
      "source": "/lib/divisions.mjs",
      "destination": "/api/division?period=blocked",
      "permanent": false
    },
    {
      "source": "/control-center",
      "destination": "/divisions",
      "permanent": false
    },
    {
      "source": "/trip-o-meter",
      "destination": "/divisions",
      "permanent": false
    },
    {
      "source": "/trip-o-meter.html",
      "destination": "/divisions",
      "permanent": false
    }
  ]
}
