{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/nest_menu_icon.png"
    }
  ],
  "functions": {
    "api/account.mjs": {
      "maxDuration": 60,
      "regions": ["sfo1"]
    },
    "api/auth.mjs": {
      "maxDuration": 60,
      "regions": ["sfo1"]
    },
    "api/spinner.mjs": {
      "maxDuration": 60
    },
    "api/leadership.mjs": {
      "maxDuration": 50
    },
    "api/weather.mjs": {
      "maxDuration": 30
    },
    "api/hiring-access.mjs": {
      "maxDuration": 30
    },
    "api/hiring.mjs": {
      "maxDuration": 40
    }
  }
}
